# Tavessa frontend environment variables (Vite).
#
# Vite env vars are embedded in the frontend bundle at BUILD time —
# they are public configuration, never secrets. Never put a token,
# password, or key in a VITE_ variable. Changing a value requires a
# rebuild (and therefore a Vercel redeploy) to take effect.

# REST API base. Leave EMPTY in production: with VITE_API_URL unset
# the frontend uses relative /api/... URLs that hit the Vercel origin
# and are proxied to Render (same-origin, so the refresh cookie
# works). In local dev the Vite proxy forwards /api to
# http://localhost:8000 (see vite.config.ts). Only set this if you
# deliberately want the browser to call a backend origin directly.
VITE_API_URL=

# WebSocket base. Production: wss://tavessa-api.onrender.com — the
# browser connects directly to Render for /ws/guest, /ws/kitchen and
# /ws/staff (Stage 10.2 decision: Vercel rewrites do not proxy
# WebSockets). Leave EMPTY for local dev: sockets then use the
# same-origin fallback through the Vite proxy.
VITE_WS_URL=
