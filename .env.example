# Tavessa — environment variables (EXAMPLE — placeholders only, never real secrets)
# Copy to .env at the repo root:  cp .env.example .env
# The backend also reads backend/.env if you run it from backend/.

# --- General ---
# development | staging | production
ENVIRONMENT=development

# --- Backend ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Long random string in production (generate: python -c "import secrets; print(secrets.token_urlsafe(48))").
# The shipped dev default is rejected when ENVIRONMENT=production.
SECRET_KEY=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://tavessa:tavessa@localhost:5432/tavessa
POSTGRES_USER=tavessa
POSTGRES_PASSWORD=tavessa
POSTGRES_DB=tavessa

# --- Frontend ---
# Leave empty in dev (Vite proxies /api to localhost:8000). In production
# set the public backend URL, e.g. https://api.example.com
VITE_API_URL=

# --- Kitchen Display System (Stage 4, dev-only) ---
# Shared dev key for the KDS: the backend checks KITCHEN_DEV_KEY and
# the frontend sends it as X-Kitchen-Dev-Key (REST) / ?dev_key= (WS).
# The KDS is development-access only until staff auth lands (see README).
# The frontend value must match the backend value; leave empty and the
# /kitchen page shows "kitchen access not configured" instead of failing.
KITCHEN_DEV_KEY=dev-kitchen-only
VITE_KITCHEN_DEV_KEY=dev-kitchen-only

# --- Waiter / Staff dashboard (Stage 5, dev-only) ---
# SEPARATE dev key from the kitchen key: a kitchen key does not grant
# staff access (and vice versa), and a guest table token grants
# nothing. The backend checks STAFF_DEV_KEY and the frontend sends it
# as X-Staff-Dev-Key (REST) / ?dev_key= (WS). Development-access only
# until staff auth lands (see README). Never a production secret.
STAFF_DEV_KEY=dev-staff-only
VITE_STAFF_DEV_KEY=dev-staff-only

# --- CORS ---
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
